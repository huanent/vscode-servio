{
  "name": "serverkit",
  "displayName": "Serverkit",
  "description": "Manage and connect to ssh mysql server and more..",
  "version": "3.0.2",
  "engines": {
    "vscode": "^1.125.0"
  },
  "license": "MIT",
  "publisher": "huanent",
  "icon": "resources/logo.png",
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionKind": [
    "ui"
  ],
  "homepage": "https://github.com/huanent/vscode-serverkit.git",
  "repository": {
    "type": "github",
    "url": "https://github.com/huanent/vscode-serverkit"
  },
  "contributes": {
    "configuration": {
      "title": "ServerKit",
      "properties": {
        "serverkit.storagePath": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "ServerKit data directory. Relative and ~ paths resolve from your home directory."
        },
        "serverkit.enableLanguageModelTools": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "Expose ServerKit operations to Copilot tools."
        }
      }
    },
    "languageModelTools": [
      {
        "name": "serverkit_list_servers",
        "when": "config.serverkit.enableLanguageModelTools",
        "toolReferenceName": "serverkitListServers",
        "displayName": "List Servers",
        "canBeReferencedInPrompt": true,
        "userDescription": "List configured servers by type.",
        "modelDescription": "List servers by type. Use serverType ssh, db, or container.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "serverType": {
              "type": "string",
              "enum": ["ssh", "db", "container"],
              "description": "Server type to list."
            }
          },
          "required": ["serverType"]
        },
        "tags": ["server", "list"]
      },
      {
        "name": "serverkit_ssh",
        "when": "config.serverkit.enableLanguageModelTools",
        "toolReferenceName": "serverkitSsh",
        "displayName": "Run SSH Command",
        "canBeReferencedInPrompt": true,
        "userDescription": "Run a command on a configured SSH server.",
        "modelDescription": "Run a shell command on an SSH server. Get serverId from serverkit_list_servers with serverType ssh.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "serverId": {
              "type": "string",
              "description": "SSH server id from serverkit_list_servers."
            },
            "command": {
              "type": "string",
              "description": "Shell command to run remotely."
            }
          },
          "required": ["serverId", "command"]
        },
        "tags": ["ssh", "command"]
      },
      {
        "name": "serverkit_sql",
        "when": "config.serverkit.enableLanguageModelTools",
        "toolReferenceName": "serverkitSql",
        "displayName": "Run SQL",
        "canBeReferencedInPrompt": true,
        "userDescription": "Run SQL on a configured database server.",
        "modelDescription": "Run one SQL statement on a database server. Get serverId from serverkit_list_servers with serverType database.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "serverId": { "type": "string", "description": "DB server id from serverkit_list_servers." },
            "database": { "type": "string", "description": "Database name to use." },
            "sql": { "type": "string", "minLength": 1, "description": "SQL statement to run." }
          },
          "required": ["serverId", "sql"]
        },
        "tags": ["database", "sql", "query"]
      },
      {
        "name": "serverkit_container",
        "when": "config.serverkit.enableLanguageModelTools",
        "toolReferenceName": "serverkitContainer",
        "displayName": "Run Container Command",
        "canBeReferencedInPrompt": true,
        "userDescription": "Run a command on a configured container runtime.",
        "modelDescription": "Run a Docker, Podman, or Apple Container command. Get serverId from serverkit_list_servers with serverType container.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "serverId": { "type": "string", "description": "Container server id from serverkit_list_servers." },
            "args": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "Runtime arguments, excluding the executable path." }
          },
          "required": ["serverId", "args"]
        },
        "tags": ["container", "runtime", "command"]
      },
      {
        "name": "serverkit_sftp",
        "when": "config.serverkit.enableLanguageModelTools",
        "toolReferenceName": "serverkitSftp",
        "displayName": "Run SFTP Operation",
        "canBeReferencedInPrompt": true,
        "userDescription": "Run an SFTP file operation on a configured SSH server.",
        "modelDescription": "Run an SFTP operation on an SSH server. Get serverId from serverkit_list_servers with serverType ssh.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "serverId": { "type": "string", "description": "SSH server id from serverkit_list_servers." },
            "action": { "type": "string", "enum": ["list", "read", "upload", "download", "delete", "mkdir", "rename"], "description": "SFTP operation to run." },
            "remotePath": { "type": "string", "description": "Remote POSIX path." },
            "localPath": { "type": "string", "description": "Local absolute path for upload or download." },
            "toRemotePath": { "type": "string", "description": "Destination remote path for rename." },
            "isDirectory": { "type": "boolean", "description": "Whether the target is a directory for delete." }
          },
          "required": ["serverId", "action", "remotePath"]
        },
        "tags": ["ssh", "sftp", "file"]
      }
    ],
    "customEditors": [
      {
        "viewType": "serverkit.editor",
        "displayName": "ServerKit",
        "selector": [
          {
            "filenamePattern": "*.serverkit"
          }
        ],
        "priority": "option"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "serverkit",
          "title": "ServerKit",
          "icon": "$(server)"
        }
      ]
    },
    "views": {
      "serverkit": [
        {
          "id": "serverkit.servers",
          "name": "ServerKit",
          "icon": "$(server)"
        }
      ]
    },
    "commands": [
      {
        "command": "serverkit.addServer",
        "title": "Add",
        "icon": "$(add)"
      },
      {
        "command": "serverkit.importServers",
        "title": "Import",
        "icon": "$(cloud-download)"
      },
      {
        "command": "serverkit.exportServers",
        "title": "Export",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "serverkit.exportServer",
        "title": "Export",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "serverkit.connectServer",
        "title": "Connect",
        "icon": "$(run-compact)"
      },
      {
        "command": "serverkit.copyHost",
        "title": "Copy Host",
        "icon": "$(copy)"
      },
      {
        "command": "serverkit.copyInfo",
        "title": "Copy Info",
        "icon": "$(copy)"
      },
      {
        "command": "serverkit.editServer",
        "title": "Edit",
        "icon": "$(edit)"
      },
      {
        "command": "serverkit.duplicateServer",
        "title": "Duplicate",
        "icon": "$(copy)"
      },
      {
        "command": "serverkit.renameGroup",
        "title": "Rename",
        "icon": "$(edit)"
      },
      {
        "command": "serverkit.moveGroupUp",
        "title": "Move Up",
        "icon": "$(arrow-up)"
      },
      {
        "command": "serverkit.moveGroupDown",
        "title": "Move Down",
        "icon": "$(arrow-down)"
      },
      {
        "command": "serverkit.moveServerUp",
        "title": "Move Up",
        "icon": "$(arrow-up)"
      },
      {
        "command": "serverkit.moveServerDown",
        "title": "Move Down",
        "icon": "$(arrow-down)"
      },
      {
        "command": "serverkit.deleteServer",
        "title": "Delete",
        "icon": "$(trash)"
      },
      {
        "command": "serverkit.openSftp",
        "title": "Open SFTP",
        "icon": "$(folder)"
      },
      {
        "command": "serverkit.runSshCommand",
        "title": "Run Script",
        "icon": "$(three-bars)"
      },
      {
        "command": "serverkit.searchServers",
        "title": "Search Servers",
        "icon": "$(search)"
      },
      {
        "command": "serverkit.clearServerSearch",
        "title": "Clear Server Search",
        "icon": "$(clear-all)"
      },
      {
        "command": "serverkit.executeMysqlSql",
        "title": "Execute SQL",
        "icon": "$(play)"
      },
      {
        "command": "serverkit.exportMysqlSqlResults",
        "title": "Export SQL Results",
        "icon": "$(cloud-download)"
      }
    ],
    "keybindings": [
      {
        "command": "serverkit.moveSelectionUp",
        "key": "alt+up",
        "mac": "alt+up",
        "when": "focusedView == serverkit.servers && listFocus && !listMultiSelection && !serverkit.serverFilterActive"
      },
      {
        "command": "serverkit.moveSelectionDown",
        "key": "alt+down",
        "mac": "alt+down",
        "when": "focusedView == serverkit.servers && listFocus && !listMultiSelection && !serverkit.serverFilterActive"
      },
      {
        "command": "serverkit.executeMysqlSql",
        "key": "f5",
        "when": "editorTextFocus && editorLangId == sql && serverkit.mysqlSqlEditorActive"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "serverkit.executeMysqlSql",
          "when": "editorLangId == sql && serverkit.mysqlSqlEditorActive",
          "group": "navigation@1"
        },
        {
          "command": "serverkit.exportMysqlSqlResults",
          "when": "activeWebviewPanelId == serverkit.mysqlSqlResults && serverkit.mysqlSqlResultsExportable",
          "group": "navigation@1"
        },
        {
          "command": "serverkit.runSshCommand",
          "when": "activeWebviewPanelId == serverkit.editor && resourceFilename == sshTerminal.serverkit && serverkit.activeSshHasCommands",
          "group": "navigation@1"
        },
        {
          "command": "serverkit.openSftp",
          "when": "activeWebviewPanelId == serverkit.editor && resourceFilename == sshTerminal.serverkit",
          "group": "navigation@2"
        }
      ],
      "view/title": [
        {
          "command": "serverkit.clearServerSearch",
          "when": "view == serverkit.servers && serverkit.serverFilterActive",
          "group": "navigation@1"
        },
        {
          "command": "serverkit.searchServers",
          "when": "view == serverkit.servers",
          "group": "navigation@2"
        },
        {
          "command": "serverkit.importServers",
          "when": "view == serverkit.servers",
          "group": "1_transfer@1"
        },
        {
          "command": "serverkit.exportServers",
          "when": "view == serverkit.servers",
          "group": "1_transfer@2"
        },
        {
          "command": "serverkit.addServer",
          "when": "view == serverkit.servers",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "serverkit.addServer",
          "when": "view == serverkit.servers && viewItem =~ /^serverGroup/",
          "group": "1_modification@1"
        },
        {
          "command": "serverkit.renameGroup",
          "when": "view == serverkit.servers && viewItem =~ /^serverGroup/",
          "group": "1_modification@2"
        },
        {
          "command": "serverkit.moveGroupUp",
          "when": "view == serverkit.servers && viewItem =~ /^serverGroup:.*moveUp/",
          "group": "1_modification@3"
        },
        {
          "command": "serverkit.moveGroupDown",
          "when": "view == serverkit.servers && viewItem =~ /^serverGroup:.*moveDown/",
          "group": "1_modification@4"
        },
        {
          "command": "serverkit.connectServer",
          "when": "view == serverkit.servers && viewItem =~ /^(ssh|mysql|container)Server/",
          "group": "inline"
        },
        {
          "command": "serverkit.editServer",
          "when": "view == serverkit.servers && !listMultiSelection && viewItem =~ /^(ssh|mysql|container)Server/",
          "group": "1_modification"
        },
        {
          "command": "serverkit.duplicateServer",
          "when": "view == serverkit.servers && !listMultiSelection && viewItem =~ /^(ssh|mysql|container)Server/",
          "group": "1_modification@1"
        },
        {
          "command": "serverkit.runSshCommand",
          "when": "view == serverkit.servers && !listMultiSelection && viewItem =~ /^sshServer:.*hasCommands/",
          "group": "1_modification@2"
        },
        {
          "command": "serverkit.copyHost",
          "when": "view == serverkit.servers && !listMultiSelection && viewItem =~ /^(ssh|mysql|container)Server/",
          "group": "1_modification@3"
        },
        {
          "command": "serverkit.copyInfo",
          "when": "view == serverkit.servers && !listMultiSelection && viewItem =~ /^(ssh|mysql|container)Server/",
          "group": "1_modification@4"
        },
        {
          "command": "serverkit.exportServer",
          "when": "view == serverkit.servers && viewItem =~ /^(ssh|mysql|container)Server/",
          "group": "1_modification@5"
        },
        {
          "command": "serverkit.moveServerUp",
          "when": "view == serverkit.servers && !listMultiSelection && viewItem =~ /^(ssh|mysql|container)Server:.*moveUp/",
          "group": "1_modification@4"
        },
        {
          "command": "serverkit.moveServerDown",
          "when": "view == serverkit.servers && !listMultiSelection && viewItem =~ /^(ssh|mysql|container)Server:.*moveDown/",
          "group": "1_modification@5"
        },
        {
          "command": "serverkit.deleteServer",
          "when": "view == serverkit.servers && viewItem =~ /^(ssh|mysql|container)Server/",
          "group": "2_delete"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "npm run compile && npm run compile:webview",
    "compile": "rimraf out && tsc -p ./",
    "compile:webview": "tsc -p webview/tsconfig.json && vite build",
    "package": "vsce package --no-yarn",
    "publish": "vsce publish --no-yarn"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "24.x",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/ssh2": "^1.15.5",
    "@types/vscode": "^1.125.0",
    "@vitejs/plugin-react": "^5.1.1",
    "@vscode/codicons": "^0.0.46-24",
    "@vscode/vsce": "^3.9.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rimraf": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.2.2"
  },
  "dependencies": {
    "mysql2": "^3.23.0",
    "ssh2": "^1.17.0"
  }
}
